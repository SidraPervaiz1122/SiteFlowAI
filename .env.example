# Environment
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite:///./backend/storage/siteflow.db

# JWT Authentication
SECRET_KEY=siteflow-super-secret-key-for-jwt-signing-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Mode: "mock" (offline deterministic) | "openai" | "gemini"
AI_PROVIDER=mock
AI_FALLBACK_ENABLED=True
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Directory
STORAGE_DIR=backend/storage
UPLOADS_DIR=backend/storage/uploads
DOCUMENTS_DIR=backend/storage/documents
